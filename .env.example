# Core application and database
DATABASE_URL=
# Use a direct (non-pooled) URL for Drizzle migrations only.
DATABASE_URL_UNPOOLED=
# Set this to the canonical HTTPS origin in production.
APP_URL=

# Optional usage limits
AI_DAILY_TOKEN_LIMIT=500000
PROVIDER_DAILY_LIMIT=200

# Optional market-data integrations
FMP_API_KEY=
TWELVE_DATA_API_KEY=
FRED_API_KEY=

# Test-only mock outcome; never configure this in production.
GSP_MOCK_FORCE_OUTCOME=

# Cloudflare AI Gateway (keep credentials server-side)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_MODELS=

# Optional alternative language-model providers
# Optional default: cloudflare, gemini, openai, or openrouter
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODELS=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODELS=
# Image/video generation can incur additional charges; enable only with an available media quota.
AI_MEDIA_ENABLED=false
# For OpenRouter, set LLM_PROVIDER=openrouter and OPENAI_API_KEY. Leave OPENAI_MODELS empty to load the live text/tool-capable catalog; openrouter/free is first.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Set OPENAI_MODELS to a comma-separated allowlist to restrict the catalog.

# Indian Market API
INDIAN_MARKET_API_BASE_URL=

# GST GSP development mock (mock server is local-only; ClearTax is not yet enabled)
GST_ENV=sandbox
GSP_PROVIDER=mock
GSP_ENV=sandbox
GSP_BASE_URL=http://127.0.0.1:4000
GSP_MOCK_PORT=4000
GSP_CLIENT_ID=local-test-client
GSP_CLIENT_SECRET=local-test-secret

# Private S3-compatible uploads (use MinIO locally; keep access keys out of source control)
UPLOADS_S3_ENDPOINT=http://127.0.0.1:9000
UPLOADS_S3_REGION=us-east-1
UPLOADS_S3_BUCKET=finvanta-uploads
UPLOADS_S3_ACCESS_KEY_ID=
UPLOADS_S3_SECRET_ACCESS_KEY=
UPLOADS_S3_CREATE_BUCKET=true
UPLOADS_S3_SSE=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
UPLOADS_CLEANUP_SECRET=

# Optional standalone Socket.IO chat service (requires Redis)
REDIS_URL=redis://127.0.0.1:6379
CHAT_PORT=4001
CHAT_ORIGIN=http://127.0.0.1:3000
CHAT_JWT_SECRET=

# BullMQ background jobs
JOBS_CONCURRENCY=4
RESEND_API_KEY=
RESEND_FROM=
EMAIL_FROM=

# Google/GitHub authorization-code login with PKCE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32-byte key as 64 hex characters or base64; generate with `openssl rand -hex 32`
OAUTH_TOKEN_ENCRYPTION_KEY=
# Register this origin's /api/auth/oauth/{google,github}/callback URLs with each provider.
OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:3000
